# ============================================================================
# ETI Stream Analyzer - Professional Build Environment
# Docker-based cross-platform build system for 100% production ready builds
# ============================================================================

# Multi-stage build for optimized final images
FROM ubuntu:22.04 AS base

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Set timezone
ENV TZ=UTC
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Install essential build tools and dependencies
RUN apt-get update && apt-get install -y \
    # Core build tools
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    git \
    curl \
    wget \
    unzip \
    \
    # Qt6 development packages
    qt6-base-dev \
    qt6-tools-dev \
    qt6-tools-dev-tools \
    libqt6core6 \
    libqt6gui6 \
    libqt6widgets6 \
    libqt6test6 \
    libqt6network6 \
    libqt6multimedia6 \
    libqt6opengl6-dev \
    \
    # ETI processing dependencies
    libfaad-dev \
    libfftw3-dev \
    libyaml-cpp-dev \
    \
    # Audio and multimedia libraries
    libasound2-dev \
    libpulse-dev \
    portaudio19-dev \
    \
    # Testing and quality tools
    lcov \
    gcovr \
    valgrind \
    cppcheck \
    clang-format \
    clang-tidy \
    \
    # Documentation tools
    doxygen \
    graphviz \
    texlive-latex-base \
    texlive-fonts-recommended \
    \
    # Packaging tools
    rpm \
    dpkg-dev \
    fakeroot \
    \
    # Cross-compilation support
    gcc-mingw-w64 \
    g++-mingw-w64 \
    wine \
    \
    && rm -rf /var/lib/apt/lists/*

# Install Google Test and Google Mock
RUN cd /tmp && \
    git clone https://github.com/google/googletest.git && \
    cd googletest && \
    mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON && \
    make -j$(nproc) && \
    make install && \
    cd / && rm -rf /tmp/googletest

# Set up environment variables for Qt6
ENV QT_SELECT=6
ENV PATH="/usr/lib/qt6/bin:$PATH"
ENV PKG_CONFIG_PATH="/usr/lib/x86_64-linux-gnu/pkgconfig:$PKG_CONFIG_PATH"

# Create build user (non-root for security)
RUN useradd -m -u 1000 builder && \
    usermod -aG sudo builder && \
    echo "builder ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Set up working directory
WORKDIR /workspace
RUN chown builder:builder /workspace

# Switch to build user
USER builder

# Copy project files
COPY --chown=builder:builder . /workspace/

# ============================================================================
# Development Stage - Full development environment
# ============================================================================
FROM base AS development

USER builder
WORKDIR /workspace

# Install additional development tools
USER root
RUN apt-get update && apt-get install -y \
    gdb \
    lldb \
    vim \
    nano \
    htop \
    tree \
    && rm -rf /var/lib/apt/lists/*

USER builder

# Set up git configuration (use build args for customization)
ARG GIT_USER_NAME="ETI Build System"
ARG GIT_USER_EMAIL="build@eti-analyzer.org"
RUN git config --global user.name "$GIT_USER_NAME" && \
    git config --global user.email "$GIT_USER_EMAIL"

# Create convenient aliases
RUN echo 'alias ll="ls -la"' >> ~/.bashrc && \
    echo 'alias build-debug="cmake -B build -S . -DCMAKE_BUILD_TYPE=Debug -DBUILD_TESTING=ON && cmake --build build -j$(nproc)"' >> ~/.bashrc && \
    echo 'alias build-release="cmake -B build -S . -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=ON && cmake --build build -j$(nproc)"' >> ~/.bashrc && \
    echo 'alias test-all="cd build && ctest --output-on-failure"' >> ~/.bashrc && \
    echo 'alias coverage="cmake --build build --target coverage"' >> ~/.bashrc

EXPOSE 8080
CMD ["/bin/bash"]

# ============================================================================
# Build Stage - Optimized for CI/CD
# ============================================================================
FROM base AS builder

USER builder
WORKDIR /workspace

# Build configuration
ARG BUILD_TYPE=Release
ARG ENABLE_TESTING=ON
ARG ENABLE_COVERAGE=OFF

# Configure CMake build
RUN cmake -B build -S . \
    -DCMAKE_BUILD_TYPE=${BUILD_TYPE} \
    -DBUILD_TESTING=${ENABLE_TESTING} \
    -DENABLE_COVERAGE=${ENABLE_COVERAGE} \
    -DCMAKE_INSTALL_PREFIX=/opt/eti-analyzer \
    -GNinja

# Build the project
RUN cmake --build build --config ${BUILD_TYPE} -j$(nproc)

# Run tests (if enabled)
RUN if [ "$ENABLE_TESTING" = "ON" ]; then \
        cd build && ctest --output-on-failure --parallel $(nproc); \
    fi

# Generate coverage report (if enabled)
RUN if [ "$ENABLE_COVERAGE" = "ON" ]; then \
        cmake --build build --target coverage; \
    fi

# Install the application
RUN cmake --build build --target install

# ============================================================================
# Production Stage - Minimal runtime environment
# ============================================================================
FROM ubuntu:22.04 AS production

# Install only runtime dependencies
RUN apt-get update && apt-get install -y \
    libqt6core6 \
    libqt6gui6 \
    libqt6widgets6 \
    libqt6network6 \
    libqt6multimedia6 \
    libfaad2 \
    libfftw3-3 \
    libyaml-cpp0.7 \
    libasound2 \
    libpulse0 \
    && rm -rf /var/lib/apt/lists/*

# Create application user
RUN useradd -m -u 1000 eti-user

# Copy application from builder stage
COPY --from=builder /opt/eti-analyzer /opt/eti-analyzer

# Set up environment
ENV PATH="/opt/eti-analyzer/bin:$PATH"
ENV LD_LIBRARY_PATH="/opt/eti-analyzer/lib:$LD_LIBRARY_PATH"

# Create data directory
RUN mkdir -p /data && chown eti-user:eti-user /data
VOLUME ["/data"]

USER eti-user
WORKDIR /data

# Default command
CMD ["ETIStreamAnalyzer"]

# ============================================================================
# Windows Cross-compilation Stage
# ============================================================================
FROM base AS windows-builder

USER builder
WORKDIR /workspace

# Install Windows-specific dependencies
USER root
RUN apt-get update && apt-get install -y \
    mingw-w64 \
    wine \
    && rm -rf /var/lib/apt/lists/*

USER builder

# Set up Windows toolchain
ENV CC=x86_64-w64-mingw32-gcc
ENV CXX=x86_64-w64-mingw32-g++
ENV AR=x86_64-w64-mingw32-ar
ENV STRIP=x86_64-w64-mingw32-strip

# Build for Windows
RUN cmake -B build-windows -S . \
    -DCMAKE_TOOLCHAIN_FILE=/workspace/cmake/Windows-cross.cmake \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTING=OFF \
    -GNinja

RUN cmake --build build-windows -j$(nproc)

# ============================================================================
# Test Stage - Comprehensive testing environment
# ============================================================================
FROM base AS testing

USER builder
WORKDIR /workspace

# Build with all testing features enabled
RUN cmake -B build-test -S . \
    -DCMAKE_BUILD_TYPE=Debug \
    -DBUILD_TESTING=ON \
    -DENABLE_COVERAGE=ON \
    -DENABLE_SANITIZERS=ON \
    -GNinja

RUN cmake --build build-test -j$(nproc)

# Run comprehensive test suite
RUN cd build-test && \
    ctest --output-on-failure --parallel $(nproc) && \
    cmake --build . --target coverage

# Static analysis
RUN cd build-test && \
    cmake --build . --target clang-tidy && \
    cmake --build . --target cppcheck

# Memory leak testing
RUN cd build-test && \
    ctest --output-on-failure -T memcheck || true

# ============================================================================
# Documentation Stage
# ============================================================================
FROM base AS documentation

USER builder
WORKDIR /workspace

# Build documentation
RUN cmake -B build-docs -S . \
    -DBUILD_DOCUMENTATION=ON \
    -GNinja

RUN cmake --build build-docs --target doc

# ============================================================================
# Package Stage - Create distribution packages
# ============================================================================
FROM base AS packager

USER builder
WORKDIR /workspace

# Build release version
RUN cmake -B build-package -S . \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTING=OFF \
    -GNinja

RUN cmake --build build-package -j$(nproc)

# Create packages
RUN cd build-package && \
    cpack -G TGZ && \
    cpack -G DEB && \
    cpack -G RPM

# ============================================================================
# AppImage Stage - Create AppImage for universal Linux distribution
# ============================================================================
FROM base AS appimage

USER builder
WORKDIR /workspace

# Download AppImage tools
RUN cd /tmp && \
    wget https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage && \
    chmod +x linuxdeploy-x86_64.AppImage && \
    wget https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/continuous/linuxdeploy-plugin-qt-x86_64.AppImage && \
    chmod +x linuxdeploy-plugin-qt-x86_64.AppImage

# Build application
RUN cmake -B build-appimage -S . \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF \
    -GNinja

RUN cmake --build build-appimage -j$(nproc)
RUN cd build-appimage && make install DESTDIR=AppDir

# Create AppImage
RUN cd build-appimage && \
    /tmp/linuxdeploy-x86_64.AppImage --appdir AppDir --plugin qt --output appimage

# ============================================================================
# Build targets summary
# ============================================================================

# Default target: development environment
FROM development

LABEL org.opencontainers.image.title="ETI Stream Analyzer Build Environment"
LABEL org.opencontainers.image.description="Professional Docker-based build system for ETI Stream Analyzer"
LABEL org.opencontainers.image.version="1.0.0"
LABEL org.opencontainers.image.vendor="ETI Analyzer Team"
LABEL org.opencontainers.image.licenses="GPL-3.0-or-later"

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD echo "ETI Stream Analyzer Build System - Ready" || exit 1

# Build instructions
RUN echo "=== ETI Stream Analyzer Build System ===" && \
    echo "Available build commands:" && \
    echo "  build-debug    - Debug build with testing" && \
    echo "  build-release  - Release build" && \
    echo "  test-all       - Run all tests" && \
    echo "  coverage       - Generate coverage report" && \
    echo "" && \
    echo "Docker build targets:" && \
    echo "  development    - Full development environment (default)" && \
    echo "  builder        - CI/CD optimized build" && \
    echo "  production     - Minimal runtime environment" && \
    echo "  testing        - Comprehensive testing with analysis" && \
    echo "  documentation  - Generate documentation" && \
    echo "  packager       - Create distribution packages" && \
    echo "  appimage       - Create universal Linux AppImage" && \
    echo "  windows-builder - Cross-compile for Windows" && \
    echo ""
