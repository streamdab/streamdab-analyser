/**
 * @file broadcast_professional.qss
 * @brief Professional Broadcast Industry Styling for ETI Stream Analyzer
 *
 * Comprehensive Qt stylesheet implementing professional broadcast industry
 * color schemes, typography, and visual standards for optimal use in
 * broadcast control environments.
 *
 * Features:
 * - Professional dark theme optimized for broadcast environments
 * - Industry-standard color coding (Green/Yellow/Red status indicators)
 * - High contrast ratios for excellent readability
 * - Consistent spacing and typography
 * - Accessibility compliant design
 * - 24/7 operation optimized (reduced eye strain)
 *
 * @author UI/UX Agent - Phase 4 Integration
 * @date 2025
 * @copyright Copyright (c) 2025 ETI Stream Analyzer Team
 */

/* =============================================================================
   GLOBAL APPLICATION STYLING
   ============================================================================= */

QApplication {
    background-color: #1e1e1e;
    color: #ffffff;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 9pt;
}

/* Main window and dialog backgrounds */
QMainWindow, QDialog, QWidget {
    background-color: #2b2b2b;
    color: #ffffff;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
}

/* =============================================================================
   MENU BAR STYLING - Professional broadcast menu system
   ============================================================================= */

QMenuBar {
    background-color: #333333;
    border-bottom: 2px solid #555555;
    color: #ffffff;
    font-weight: bold;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 8px 12px;
    margin: 0px 2px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QMenuBar::item:pressed {
    background-color: #106ebe;
}

QMenu {
    background-color: #3a3a3a;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 4px;
    color: #ffffff;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 20px 6px 30px;
    border-radius: 3px;
    margin: 1px;
}

QMenu::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #555555;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    left: 6px;
}

/* =============================================================================
   TOOLBAR STYLING - Professional broadcast toolbar design
   ============================================================================= */

QToolBar {
    background-color: #383838;
    border: 1px solid #555555;
    border-radius: 4px;
    spacing: 3px;
    padding: 4px;
    font-weight: bold;
}

QToolBar::handle {
    background-color: #555555;
    width: 8px;
    margin: 4px 2px;
    border-radius: 2px;
}

QToolBar::separator {
    background-color: #555555;
    width: 2px;
    height: 20px;
    margin: 4px 6px;
    border-radius: 1px;
}

QToolButton {
    background-color: #505050;
    border: 1px solid #666666;
    border-radius: 4px;
    padding: 6px;
    margin: 1px;
    color: #ffffff;
    font-weight: bold;
}

QToolButton:hover {
    background-color: #606060;
    border-color: #777777;
}

QToolButton:pressed {
    background-color: #404040;
    border-color: #555555;
}

QToolButton:checked {
    background-color: #0078d4;
    border-color: #106ebe;
    color: #ffffff;
}

QToolButton:disabled {
    background-color: #333333;
    border-color: #444444;
    color: #666666;
}

/* =============================================================================
   STATUS BAR STYLING - Professional status indicators
   ============================================================================= */

QStatusBar {
    background-color: #333333;
    border-top: 2px solid #555555;
    color: #ffffff;
    font-weight: bold;
    padding: 4px;
}

QStatusBar::item {
    border: none;
    padding: 0px 8px;
}

QStatusBar QLabel {
    background-color: transparent;
    padding: 2px 8px;
    border-radius: 3px;
    font-weight: bold;
}

/* Status indicator colors */
QStatusBar QLabel[status="good"] {
    color: #4caf50;
    background-color: rgba(76, 175, 80, 0.1);
}

QStatusBar QLabel[status="warning"] {
    color: #ff9800;
    background-color: rgba(255, 152, 0, 0.1);
}

QStatusBar QLabel[status="error"] {
    color: #f44336;
    background-color: rgba(244, 67, 54, 0.1);
}

/* =============================================================================
   DOCK WIDGETS - Professional dockable panels
   ============================================================================= */

QDockWidget {
    background-color: #2b2b2b;
    color: #ffffff;
    border: 2px solid #555555;
    border-radius: 6px;
    titlebar-close-icon: url(:/icons/dock_close.png);
    titlebar-normal-icon: url(:/icons/dock_float.png);
}

QDockWidget::title {
    background-color: #404040;
    color: #ffffff;
    font-weight: bold;
    font-size: 10pt;
    padding: 8px;
    border-bottom: 1px solid #555555;
    text-align: center;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QDockWidget::close-button, QDockWidget::float-button {
    background-color: #505050;
    border: 1px solid #666666;
    border-radius: 3px;
    padding: 2px;
    margin: 2px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: #606060;
}

/* =============================================================================
   PUSH BUTTONS - Professional broadcast control buttons
   ============================================================================= */

QPushButton {
    background-color: #505050;
    border: 2px solid #666666;
    border-radius: 6px;
    padding: 8px 16px;
    color: #ffffff;
    font-weight: bold;
    font-size: 9pt;
    min-width: 80px;
    min-height: 28px;
    text-align: center;
}

QPushButton:hover {
    background-color: #606060;
    border-color: #777777;
}

QPushButton:pressed {
    background-color: #404040;
    border-color: #555555;
    padding: 9px 15px 7px 17px; /* Pressed effect */
}

QPushButton:checked {
    background-color: #0078d4;
    border-color: #106ebe;
    color: #ffffff;
}

QPushButton:default {
    border-color: #0078d4;
    border-width: 3px;
}

QPushButton:disabled {
    background-color: #333333;
    border-color: #444444;
    color: #666666;
}

/* Special button types */
QPushButton[buttonType="emergency"] {
    background-color: #d32f2f;
    border-color: #b71c1c;
}

QPushButton[buttonType="emergency"]:hover {
    background-color: #f44336;
    border-color: #d32f2f;
}

QPushButton[buttonType="warning"] {
    background-color: #f57c00;
    border-color: #e65100;
}

QPushButton[buttonType="warning"]:hover {
    background-color: #ff9800;
    border-color: #f57c00;
}

QPushButton[buttonType="success"] {
    background-color: #388e3c;
    border-color: #1b5e20;
}

QPushButton[buttonType="success"]:hover {
    background-color: #4caf50;
    border-color: #388e3c;
}

/* =============================================================================
   GROUP BOXES - Professional panel organization
   ============================================================================= */

QGroupBox {
    background-color: #353535;
    border: 2px solid #555555;
    border-radius: 8px;
    margin-top: 1ex;
    padding-top: 12px;
    font-weight: bold;
    font-size: 10pt;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 8px 0 8px;
    background-color: #2b2b2b;
    color: #ffffff;
    border-radius: 3px;
    font-weight: bold;
}

/* Alert level group boxes */
QGroupBox[alertLevel="info"] {
    border-color: #4caf50;
}

QGroupBox[alertLevel="warning"] {
    border-color: #ff9800;
}

QGroupBox[alertLevel="critical"] {
    border-color: #ff5722;
}

QGroupBox[alertLevel="emergency"] {
    border-color: #f44336;
}

/* =============================================================================
   TAB WIDGETS - Professional tabbed interfaces
   ============================================================================= */

QTabWidget::pane {
    background-color: #3a3a3a;
    border: 2px solid #555555;
    border-radius: 6px;
    margin-top: 4px;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar::tab {
    background-color: #404040;
    color: #cccccc;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border: 1px solid #555555;
    font-weight: bold;
    min-width: 100px;
}

QTabBar::tab:selected {
    background-color: #3a3a3a;
    color: #ffffff;
    border-bottom: 3px solid #0078d4;
    border-top: 2px solid #0078d4;
}

QTabBar::tab:hover:!selected {
    background-color: #4a4a4a;
    color: #ffffff;
}

QTabBar::tab:disabled {
    background-color: #2a2a2a;
    color: #555555;
}

/* =============================================================================
   INPUT CONTROLS - Professional form controls
   ============================================================================= */

/* Line Edits */
QLineEdit {
    background-color: #404040;
    border: 2px solid #666666;
    border-radius: 4px;
    padding: 6px 8px;
    color: #ffffff;
    font-size: 9pt;
    selection-background-color: #0078d4;
}

QLineEdit:focus {
    border-color: #0078d4;
    background-color: #454545;
}

QLineEdit:disabled {
    background-color: #333333;
    border-color: #444444;
    color: #666666;
}

QLineEdit[invalid="true"] {
    border-color: #f44336;
    background-color: rgba(244, 67, 54, 0.1);
}

/* Spin Boxes */
QSpinBox, QDoubleSpinBox {
    background-color: #404040;
    border: 2px solid #666666;
    border-radius: 4px;
    padding: 6px;
    color: #ffffff;
    font-size: 9pt;
    min-width: 80px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #0078d4;
    background-color: #454545;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #555555;
    border: 1px solid #666666;
    width: 20px;
    height: 12px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #606060;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow,
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 8px;
    height: 8px;
}

/* Combo Boxes */
QComboBox {
    background-color: #404040;
    border: 2px solid #666666;
    border-radius: 4px;
    padding: 6px 8px;
    color: #ffffff;
    font-size: 9pt;
    min-width: 120px;
}

QComboBox:focus {
    border-color: #0078d4;
}

QComboBox::drop-down {
    background-color: #555555;
    border: none;
    border-left: 1px solid #666666;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    width: 20px;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    background-color: #ffffff;
}

QComboBox QAbstractItemView {
    background-color: #3a3a3a;
    border: 2px solid #555555;
    border-radius: 4px;
    selection-background-color: #0078d4;
    color: #ffffff;
    outline: none;
}

/* Check Boxes */
QCheckBox {
    color: #ffffff;
    font-size: 9pt;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #666666;
    border-radius: 3px;
    background-color: #404040;
}

QCheckBox::indicator:hover {
    border-color: #777777;
    background-color: #454545;
}

QCheckBox::indicator:checked {
    background-color: #0078d4;
    border-color: #106ebe;
    image: url(:/icons/checkbox_check.png);
}

QCheckBox::indicator:disabled {
    background-color: #333333;
    border-color: #444444;
}

/* Radio Buttons */
QRadioButton {
    color: #ffffff;
    font-size: 9pt;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #666666;
    border-radius: 9px;
    background-color: #404040;
}

QRadioButton::indicator:hover {
    border-color: #777777;
    background-color: #454545;
}

QRadioButton::indicator:checked {
    background-color: #0078d4;
    border-color: #106ebe;
}

QRadioButton::indicator:checked::after {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: #ffffff;
    left: 5px;
    top: 5px;
}

/* =============================================================================
   SLIDERS - Professional control sliders
   ============================================================================= */

QSlider::groove:horizontal {
    background-color: #404040;
    border: 1px solid #666666;
    height: 12px;
    border-radius: 6px;
    margin: 0;
}

QSlider::handle:horizontal {
    background-color: #0078d4;
    border: 2px solid #106ebe;
    width: 20px;
    height: 20px;
    margin: -4px 0;
    border-radius: 10px;
}

QSlider::handle:horizontal:hover {
    background-color: #1e88e5;
    border-color: #1976d2;
}

QSlider::groove:vertical {
    background-color: #404040;
    border: 1px solid #666666;
    width: 12px;
    border-radius: 6px;
    margin: 0;
}

QSlider::handle:vertical {
    background-color: #0078d4;
    border: 2px solid #106ebe;
    width: 20px;
    height: 20px;
    margin: 0 -4px;
    border-radius: 10px;
}

/* =============================================================================
   PROGRESS BARS - Professional status indicators
   ============================================================================= */

QProgressBar {
    background-color: #404040;
    border: 2px solid #666666;
    border-radius: 6px;
    text-align: center;
    color: #ffffff;
    font-weight: bold;
    font-size: 9pt;
    min-height: 24px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                    stop: 0 #4caf50, stop: 0.6 #8bc34a,
                                    stop: 0.8 #ffeb3b, stop: 1.0 #f44336);
    border-radius: 4px;
    margin: 2px;
}

/* Alert level progress bars */
QProgressBar[level="info"]::chunk {
    background-color: #4caf50;
}

QProgressBar[level="warning"]::chunk {
    background-color: #ff9800;
}

QProgressBar[level="critical"]::chunk {
    background-color: #ff5722;
}

QProgressBar[level="emergency"]::chunk {
    background-color: #f44336;
}

/* =============================================================================
   LIST AND TABLE WIDGETS - Professional data displays
   ============================================================================= */

/* List Widgets */
QListWidget {
    background-color: #404040;
    border: 2px solid #666666;
    border-radius: 6px;
    color: #ffffff;
    font-size: 9pt;
    alternate-background-color: #454545;
    outline: none;
}

QListWidget::item {
    background-color: transparent;
    border: none;
    padding: 6px 8px;
    margin: 1px;
    border-radius: 3px;
}

QListWidget::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QListWidget::item:hover {
    background-color: #4a4a4a;
}

/* Table Widgets */
QTableWidget {
    background-color: #404040;
    border: 2px solid #666666;
    border-radius: 6px;
    color: #ffffff;
    font-size: 9pt;
    gridline-color: #555555;
    alternate-background-color: #454545;
    outline: none;
}

QTableWidget::item {
    background-color: transparent;
    border: none;
    padding: 6px;
    margin: 0px;
}

QTableWidget::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QTableWidget::item:hover {
    background-color: #4a4a4a;
}

QHeaderView::section {
    background-color: #505050;
    color: #ffffff;
    font-weight: bold;
    font-size: 9pt;
    padding: 8px;
    border: 1px solid #666666;
    border-radius: 0px;
}

QHeaderView::section:horizontal {
    border-bottom: 2px solid #0078d4;
}

QHeaderView::section:vertical {
    border-right: 2px solid #0078d4;
}

/* Tree Widgets */
QTreeWidget {
    background-color: #404040;
    border: 2px solid #666666;
    border-radius: 6px;
    color: #ffffff;
    font-size: 9pt;
    alternate-background-color: #454545;
    outline: none;
}

QTreeWidget::item {
    background-color: transparent;
    border: none;
    padding: 4px;
    margin: 0px;
}

QTreeWidget::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QTreeWidget::item:hover {
    background-color: #4a4a4a;
}

QTreeWidget::branch:closed:has-children {
    image: url(:/icons/tree_closed.png);
}

QTreeWidget::branch:open:has-children {
    image: url(:/icons/tree_open.png);
}

/* =============================================================================
   TEXT WIDGETS - Professional text displays
   ============================================================================= */

QTextEdit, QPlainTextEdit {
    background-color: #404040;
    border: 2px solid #666666;
    border-radius: 6px;
    color: #ffffff;
    font-family: "Consolas", "Monaco", "Courier New", monospace;
    font-size: 9pt;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #0078d4;
}

/* Specialized text displays */
QTextEdit[displayType="log"] {
    background-color: #1e1e1e;
    color: #d4d4d4;
    font-family: "Consolas", "Monaco", monospace;
    font-size: 8pt;
}

QTextEdit[displayType="yaml"] {
    background-color: #2d2d30;
    color: #dcdcaa;
    font-family: "Consolas", monospace;
}

QTextEdit[displayType="json"] {
    background-color: #1e1e1e;
    color: #ce9178;
    font-family: "Consolas", monospace;
}

/* =============================================================================
   SCROLL BARS - Professional scroll controls
   ============================================================================= */

QScrollBar:vertical {
    background-color: #2b2b2b;
    border: 1px solid #555555;
    border-radius: 6px;
    width: 16px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #606060;
    border: 1px solid #777777;
    border-radius: 5px;
    min-height: 20px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #707070;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background-color: #505050;
    border: 1px solid #666666;
    height: 16px;
    subcontrol-origin: margin;
}

QScrollBar::add-line:vertical:hover, QScrollBar::sub-line:vertical:hover {
    background-color: #606060;
}

QScrollBar:horizontal {
    background-color: #2b2b2b;
    border: 1px solid #555555;
    border-radius: 6px;
    height: 16px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #606060;
    border: 1px solid #777777;
    border-radius: 5px;
    min-width: 20px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #707070;
}

/* =============================================================================
   SPLITTERS - Professional panel dividers
   ============================================================================= */

QSplitter::handle {
    background-color: #555555;
    border: 1px solid #666666;
    border-radius: 3px;
    margin: 2px;
}

QSplitter::handle:horizontal {
    width: 8px;
}

QSplitter::handle:vertical {
    height: 8px;
}

QSplitter::handle:hover {
    background-color: #0078d4;
}

/* =============================================================================
   LABELS - Professional text display
   ============================================================================= */

QLabel {
    background-color: transparent;
    color: #ffffff;
    font-size: 9pt;
}

QLabel[labelType="title"] {
    font-size: 12pt;
    font-weight: bold;
    color: #0078d4;
}

QLabel[labelType="subtitle"] {
    font-size: 10pt;
    font-weight: bold;
    color: #cccccc;
}

QLabel[labelType="status"] {
    padding: 4px 8px;
    border-radius: 4px;
    font-weight: bold;
}

QLabel[status="good"] {
    background-color: rgba(76, 175, 80, 0.2);
    color: #4caf50;
    border: 1px solid #4caf50;
}

QLabel[status="warning"] {
    background-color: rgba(255, 152, 0, 0.2);
    color: #ff9800;
    border: 1px solid #ff9800;
}

QLabel[status="error"] {
    background-color: rgba(244, 67, 54, 0.2);
    color: #f44336;
    border: 1px solid #f44336;
}

QLabel[status="info"] {
    background-color: rgba(33, 150, 243, 0.2);
    color: #2196f3;
    border: 1px solid #2196f3;
}

/* =============================================================================
   FRAMES - Professional panel borders
   ============================================================================= */

QFrame {
    background-color: transparent;
    border: none;
}

QFrame[frameShape="1"], QFrame[frameShape="2"], QFrame[frameShape="3"] {
    border: 1px solid #555555;
}

QFrame[frameShape="4"], QFrame[frameShape="5"] {
    background-color: #555555;
}

QFrame[frameStyle="panel"] {
    background-color: #353535;
    border: 2px solid #555555;
    border-radius: 4px;
    padding: 4px;
}

/* =============================================================================
   TOOLTIPS - Professional help system
   ============================================================================= */

QToolTip {
    background-color: #2b2b2b;
    border: 2px solid #0078d4;
    border-radius: 4px;
    padding: 6px 10px;
    color: #ffffff;
    font-size: 9pt;
    font-weight: normal;
    opacity: 240;
}

/* =============================================================================
   SPECIALIZED WIDGETS - Custom professional components
   ============================================================================= */

/* Alert Status Widgets */
QWidget[widgetType="alertStatus"] {
    background-color: #353535;
    border: 2px solid #555555;
    border-radius: 6px;
    padding: 4px;
}

QWidget[widgetType="alertStatus"][level="info"] {
    border-color: #4caf50;
    background-color: rgba(76, 175, 80, 0.1);
}

QWidget[widgetType="alertStatus"][level="warning"] {
    border-color: #ff9800;
    background-color: rgba(255, 152, 0, 0.1);
}

QWidget[widgetType="alertStatus"][level="critical"] {
    border-color: #ff5722;
    background-color: rgba(255, 87, 34, 0.1);
}

QWidget[widgetType="alertStatus"][level="emergency"] {
    border-color: #f44336;
    background-color: rgba(244, 67, 54, 0.1);
}

/* Performance Indicators */
QWidget[widgetType="performanceIndicator"] {
    background-color: #2b2b2b;
    border: 2px solid #666666;
    border-radius: 4px;
    padding: 2px;
}

QProgressBar[indicatorType="performance"] {
    background-color: #333333;
    border: 1px solid #555555;
    border-radius: 3px;
    text-align: center;
    font-size: 8pt;
    font-weight: bold;
    height: 18px;
}

QProgressBar[indicatorType="performance"]::chunk {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                    stop: 0 #f44336, stop: 0.3 #ff9800,
                                    stop: 0.6 #ffeb3b, stop: 1.0 #4caf50);
    border-radius: 2px;
}

/* =============================================================================
   ANIMATION AND TRANSITIONS
   ============================================================================= */

/* Smooth transitions for professional feel */
QPushButton, QToolButton, QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox {
    transition: all 0.2s ease-in-out;
}

QTabBar::tab {
    transition: all 0.15s ease-in-out;
}

/* =============================================================================
   ACCESSIBILITY AND HIGH CONTRAST
   ============================================================================= */

/* High contrast mode overrides */
QWidget:focus {
    outline: 2px solid #0078d4;
    outline-offset: 1px;
}

/* Ensure minimum contrast ratios for accessibility */
QLabel, QPushButton, QCheckBox, QRadioButton {
    color: #ffffff; /* White on dark ensures high contrast */
}

/* =============================================================================
   RESPONSIVE DESIGN - Scaling for different screen sizes
   ============================================================================= */

/* Large screens (>1920px) */
@media screen and (min-width: 1920px) {
    QApplication { font-size: 10pt; }
    QLabel[labelType="title"] { font-size: 14pt; }
    QPushButton { min-height: 32px; padding: 10px 20px; }
    QToolButton { padding: 8px; }
}

/* Small screens (<1366px) */
@media screen and (max-width: 1366px) {
    QApplication { font-size: 8pt; }
    QLabel[labelType="title"] { font-size: 10pt; }
    QPushButton { min-height: 24px; padding: 6px 12px; }
    QToolButton { padding: 4px; }
}

/* =============================================================================
   PRINT STYLES - For report generation
   ============================================================================= */

@media print {
    QWidget {
        background-color: white;
        color: black;
    }

    QPushButton, QToolButton {
        border: 1px solid black;
        background-color: white;
        color: black;
    }
}

/* =============================================================================
   END OF BROADCAST PROFESSIONAL STYLESHEET
   ============================================================================= */
