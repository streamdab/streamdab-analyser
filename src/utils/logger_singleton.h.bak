#pragma once

#include <QObject>
#include <QTimer>
#include <QDateTime>
#include <QFile>
#include <QTextStream>
#include <QDir>
#include <QMutex>
#include <QWaitCondition>
#include <QThread>
#include <QQueue>
#include <QVariantHash>
#include <QString>
#include <QStringList>
#include <QDebug>
#include <memory>

/**
 * @class Logger
 * @brief Professional Logging Framework for ETI Stream Analyzer (Singleton)
 * 
 * Thread-safe logging system with structured output and professional
 * export capabilities for broadcast industry standards.
 * 
 * This is a singleton implementation that provides compatibility with
 * existing code while maintaining the full feature set.
 */
class Logger : public QObject
{
    Q_OBJECT

public:
    /**
     * @brief Log severity levels for message classification
     */
    enum LogLevel {
        Debug = 0,     // Detailed debugging information
        Info = 1,      // Informational messages
        Warning = 2,   // Warning conditions
        Error = 3,     // Error conditions
        Critical = 4   // Critical conditions requiring immediate attention
    };
    Q_ENUM(LogLevel)

    /**
     * @brief Get singleton instance
     * @return Reference to Logger instance
     */
    static Logger& instance() {
        static Logger s_instance;
        return s_instance;
    }

    /**
     * @brief Initialize the logging system
     * @return true if initialization successful
     */
    bool initialize();

    /**
     * @brief Check if logging system is initialized
     * @return true if initialized
     */
    bool isInitialized() const { return m_initialized; }

    /**
     * @brief Set minimum log level for output
     * @param level Minimum level to log
     */
    void setLogLevel(LogLevel level) { m_logLevel = level; }

    /**
     * @brief Get current log level
     * @return Current minimum log level
     */
    LogLevel getLogLevel() const { return m_logLevel; }

    /**
     * @brief Log message with specified level
     * @param level Log level
     * @param category Message category
     * @param message Message text
     */
    void log(LogLevel level, const QString& category, const QString& message) {
        if (level >= m_logLevel) {
            QMutexLocker locker(&m_mutex);
            
            QString levelStr = logLevelToString(level);
            QString timestamp = QDateTime::currentDateTime().toString("yyyy-MM-dd hh:mm:ss.zzz");
            QString formatted = QString("[%1] [%2] %3: %4")
                               .arg(timestamp, levelStr, category, message);
            
            // Console output for immediate feedback
            qDebug().noquote() << formatted;
            
            // Store in memory for GUI display
            if (m_recentMessages.size() >= MAX_RECENT_MESSAGES) {
                m_recentMessages.removeFirst();
            }
            m_recentMessages.append({level, category, message, QDateTime::currentDateTime()});
            
            // Emit signal for GUI updates
            emit logMessageAdded(level, message, category, QDateTime::currentDateTime());
            
            if (level >= Error) {
                emit errorMessageAdded(message, QDateTime::currentDateTime());
            }
        }
    }

    /**
     * @brief Log debug message
     * @param category Message category
     * @param message Message text
     */
    void logDebug(const QString& category, const QString& message) {
        log(Debug, category, message);
    }

    /**
     * @brief Log info message
     * @param category Message category
     * @param message Message text
     */
    void logInfo(const QString& category, const QString& message) {
        log(Info, category, message);
    }

    /**
     * @brief Log warning message
     * @param category Message category
     * @param message Message text
     */
    void logWarning(const QString& category, const QString& message) {
        log(Warning, category, message);
    }

    /**
     * @brief Log error message
     * @param category Message category
     * @param message Message text
     */
    void logError(const QString& category, const QString& message) {
        log(Error, category, message);
    }

    /**
     * @brief Log critical message
     * @param category Message category
     * @param message Message text
     */
    void logCritical(const QString& category, const QString& message) {
        log(Critical, category, message);
    }

    /**
     * @brief Get recent log messages for GUI display
     * @param maxCount Maximum number of messages to return
     * @return List of recent log messages
     */
    struct LogMessage {
        LogLevel level;
        QString category;
        QString message;
        QDateTime timestamp;
    };

    QList<LogMessage> getRecentMessages(int maxCount = 100) const {
        QMutexLocker locker(&m_mutex);
        int count = qMin(maxCount, m_recentMessages.size());
        return m_recentMessages.mid(m_recentMessages.size() - count);
    }

signals:
    /**
     * @brief Emitted when a new log message is added
     * @param level Log level
     * @param message Message text
     * @param category Message category
     * @param timestamp Message timestamp
     */
    void logMessageAdded(LogLevel level, const QString& message, 
                        const QString& category, const QDateTime& timestamp);

    /**
     * @brief Emitted specifically for error messages (for GUI alerts)
     * @param message Error message
     * @param timestamp Error timestamp
     */
    void errorMessageAdded(const QString& message, const QDateTime& timestamp);

private:
    /**
     * @brief Private constructor for singleton
     */
    explicit Logger(QObject *parent = nullptr)
        : QObject(parent)
        , m_initialized(false)
        , m_logLevel(Info)
    {
        // Initialize immediately for simplicity
        m_initialized = true;
    }

    /**
     * @brief Convert log level to string
     * @param level Log level
     * @return String representation
     */
    QString logLevelToString(LogLevel level) const {
        switch (level) {
            case Debug:    return "DEBUG";
            case Info:     return "INFO";
            case Warning:  return "WARNING";
            case Error:    return "ERROR";
            case Critical: return "CRITICAL";
            default:       return "UNKNOWN";
        }
    }

    // Member variables
    bool m_initialized;
    LogLevel m_logLevel;
    mutable QMutex m_mutex;
    QList<LogMessage> m_recentMessages;

    // Constants
    static constexpr int MAX_RECENT_MESSAGES = 1000;
};

// Register metatype for Qt signals
Q_DECLARE_METATYPE(Logger::LogLevel)