Categories=AudioVideo;Audio;Video;Development;Engineering;
Keywords=ETI;DAB;Broadcasting;Stream;Analysis;ETSI;Professional;
Actions=Analyze;

[Desktop Action Analyze]
Name=Analyze ETI Stream
Icon=eti-stream-analyzer
Exec=ETIStreamAnalyzer --analyze %F
