            "problemMatcher": [
                {
                    "owner": "gtest",
                    "fileLocation": ["relative", "${workspaceFolder}"],
                    "pattern": {
                        "regexp": "^(.*):(\\d+):\\s+(FAIL|ERROR)\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "severity": 3,
                        "message": 4
                    }
                }
            ]
        },
        {
            "label": "👀 TDD: Watch Mode",
            "type": "shell",
            "command": "./scripts/tdd_dev.sh",
            "args": ["watch"],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "isBackground": true
        },
        {
            "label": "🧹 Clean Build",
            "type": "shell",
            "command": "./scripts/tdd_dev.sh",
            "args": ["clean"],
            "group": "build",
            "presentation": {
                "echo": true,
