                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc",
                {
                    "owner": "gtest",
                    "fileLocation": ["relative", "${workspaceFolder}"],
                    "pattern": {
                        "regexp": "^(.*):(\\d+):\\s+(.*error.*):\\s+(.*)$",
                        "file": 1,
