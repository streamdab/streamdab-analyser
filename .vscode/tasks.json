{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "TDD: Setup Environment",
            "type": "shell",
            "command": "./scripts/tdd_dev.sh",
            "args": ["setup"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "🔴 TDD: RED Phase",
            "type": "shell",
            "command": "./scripts/tdd_dev.sh",
            "args": ["red"],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc",
                {
                    "owner": "gtest",
                    "fileLocation": ["relative", "${workspaceFolder}"],
                    "pattern": {
                        "regexp": "^(.*):(\\d+):\\s+(.*error.*):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "severity": 3,
                        "message": 4
                    }
                }
            ]
        },
        {
            "label": "🟢 TDD: GREEN Phase",
            "type": "shell",
