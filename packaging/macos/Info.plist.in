<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Professional Bundle Information -->
    <key>CFBundleName</key>
    <string>ETI Stream Analyzer</string>

    <key>CFBundleDisplayName</key>
    <string>ETI Stream Analyzer Professional</string>

    <key>CFBundleIdentifier</key>
    <string>org.eti-analyzer.desktop</string>

    <key>CFBundleVersion</key>
    <string>${PROJECT_VERSION}</string>

    <key>CFBundleShortVersionString</key>
    <string>${PROJECT_VERSION}</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleSignature</key>
    <string>ETIA</string>

    <key>CFBundleExecutable</key>
    <string>ETIStreamAnalyzer</string>

    <key>CFBundleIconFile</key>
    <string>eti-analyzer.icns</string>

    <!-- Professional Application Information -->
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <key>NSHighResolutionCapable</key>
    <true/>

    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>

    <!-- Professional Copyright and Credits -->
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2024 Professional Broadcast Tools. All rights reserved.</string>

    <key>CFBundleGetInfoString</key>
    <string>ETI Stream Analyzer Professional v${PROJECT_VERSION} - Professional ETI/DAB Stream Analysis Tool</string>

    <!-- Professional File Type Associations -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>ETI Stream File</string>

            <key>CFBundleTypeDescription</key>
            <string>ETI (Ensemble Transport Interface) Stream File</string>

            <key>CFBundleTypeRole</key>
            <string>Editor</string>

            <key>CFBundleTypeIconFile</key>
            <string>eti-file.icns</string>

            <key>LSHandlerRank</key>
            <string>Owner</string>

            <key>LSItemContentTypes</key>
            <array>
                <string>org.eti-analyzer.eti-stream</string>
            </array>

            <key>CFBundleTypeExtensions</key>
            <array>
                <string>eti</string>
            </array>

            <key>CFBundleTypeMIMETypes</key>
            <array>
                <string>application/x-eti-stream</string>
            </array>
        </dict>

        <dict>
            <key>CFBundleTypeName</key>
            <string>ETI-NI Stream File</string>

            <key>CFBundleTypeDescription</key>
            <string>ETI Network Interface Stream File</string>

            <key>CFBundleTypeRole</key>
            <string>Editor</string>

            <key>CFBundleTypeIconFile</key>
            <string>eti-file.icns</string>

            <key>LSHandlerRank</key>
            <string>Owner</string>

            <key>CFBundleTypeExtensions</key>
            <array>
                <string>etini</string>
            </array>

            <key>CFBundleTypeMIMETypes</key>
            <array>
                <string>application/x-eti-ni</string>
            </array>
        </dict>
    </array>

    <!-- Professional Uniform Type Identifiers -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.eti-analyzer.eti-stream</string>

            <key>UTTypeDescription</key>
            <string>ETI Stream File</string>

            <key>UTTypeIconFile</key>
            <string>eti-file.icns</string>

            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.content</string>
            </array>

            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>eti</string>
                </array>

                <key>public.mime-type</key>
                <array>
                    <string>application/x-eti-stream</string>
                </array>
            </dict>
        </dict>
    </array>

    <!-- Professional Application Category -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.video</string>

    <!-- Professional URL Schemes (for future integration) -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>ETI Stream Protocol</string>

            <key>CFBundleURLSchemes</key>
            <array>
                <string>eti</string>
                <string>eti-stream</string>
            </array>
        </dict>
    </array>

    <!-- Professional Security and Permissions -->
    <key>NSAppleEventsUsageDescription</key>
    <string>ETI Stream Analyzer uses Apple Events for professional broadcast automation workflows.</string>

    <key>NSMicrophoneUsageDescription</key>
    <string>ETI Stream Analyzer may access the microphone for live audio monitoring during ETI stream analysis.</string>

    <key>NSNetworkVolumesUsageDescription</key>
    <string>ETI Stream Analyzer accesses network volumes to analyze ETI streams from broadcast infrastructure.</string>

    <!-- Professional macOS Integration -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Analyze ETI Stream</string>
            </dict>

            <key>NSMessage</key>
            <string>analyzeETIStream</string>

            <key>NSPortName</key>
            <string>ETI Stream Analyzer</string>

            <key>NSRequiredContext</key>
            <dict>
                <key>NSTextContent</key>
                <string>FilePath</string>
            </dict>

            <key>NSSendTypes</key>
            <array>
                <string>NSFilenamesPboardType</string>
            </array>
        </dict>
    </array>

    <!-- Professional Development Information -->
    <key>DTPlatformName</key>
    <string>macosx</string>

    <key>DTSDKName</key>
    <string>macosx</string>

    <key>DTXcode</key>
    <string>1500</string>

    <key>DTXcodeBuild</key>
    <string>15A240d</string>

    <!-- Professional Minimum System Requirements -->
    <key>LSMinimumSystemVersion</key>
    <string>10.15</string>

    <key>LSRequiresNativeExecution</key>
    <true/>

    <!-- Professional Application Behavior -->
    <key>NSQuitAlwaysKeepsWindows</key>
    <true/>

    <key>NSUsesSavedApplicationState</key>
    <true/>

    <key>NSSupportsAutomaticTermination</key>
    <true/>

    <key>NSSupportsSuddenTermination</key>
    <false/>
</dict>
</plist>
