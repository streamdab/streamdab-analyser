<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  StreamDAB Analyser — macOS Info.plist template.

  Wired into the .app bundle via MACOSX_BUNDLE_INFO_PLIST (CMakeLists.txt).
  The @MACOSX_BUNDLE_*@ placeholders are substituted by CMake from the
  MACOSX_BUNDLE_* target properties (single source: DABX_VERSION for the
  version keys). Do NOT use @PROJECT_VERSION@ here — CMake does not replace it.
  CFBundleIconFile is deliberately absent: the project ships an SVG only; a
  Finder .icns is a documented follow-up (MACOSX_BUNDLE_ICON_FILE is unset).
-->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>StreamDAB Analyser</string>
    <key>CFBundleExecutable</key>
    <string>@MACOSX_BUNDLE_EXECUTABLE_NAME@</string>
    <key>CFBundleIdentifier</key>
    <string>@MACOSX_BUNDLE_GUI_IDENTIFIER@</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>@MACOSX_BUNDLE_BUNDLE_NAME@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@MACOSX_BUNDLE_SHORT_VERSION_STRING@</string>
    <key>CFBundleSignature</key>
    <string>SDBZ</string>
    <key>CFBundleVersion</key>
    <string>@MACOSX_BUNDLE_BUNDLE_VERSION@</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>

    <!-- Document Types for ETI/DAB/EDI file associations -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeDescription</key>
            <string>ETI Stream File</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>eti</string>
            </array>
            <key>CFBundleTypeName</key>
            <string>ETI Stream</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.streamdab-analyser.eti-stream</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeDescription</key>
            <string>DAB Stream File</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>dab</string>
            </array>
            <key>CFBundleTypeName</key>
            <string>DAB Stream</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
        </dict>
        <dict>
            <key>CFBundleTypeDescription</key>
            <string>EDI Stream File</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>edi</string>
            </array>
            <key>CFBundleTypeName</key>
            <string>EDI Stream</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
        </dict>
    </array>

    <!-- UTI (Uniform Type Identifier) Exports -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.content</string>
            </array>
            <key>UTTypeDescription</key>
            <string>ETI Stream File</string>
            <key>UTTypeIdentifier</key>
            <string>com.streamdab-analyser.eti-stream</string>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>eti</string>
                </array>
                <key>public.mime-type</key>
                <array>
                    <string>application/x-eti-stream</string>
                </array>
            </dict>
        </dict>
    </array>

    <!-- High DPI Support -->
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>

    <!-- Privacy Usage Descriptions -->
    <key>NSMicrophoneUsageDescription</key>
    <string>StreamDAB Analyser needs microphone access for real-time audio monitoring and analysis of broadcast streams.</string>
    <key>NSNetworkVolumesUsageDescription</key>
    <string>StreamDAB Analyser accesses network volumes to analyze ETI streams from network-attached storage and broadcast servers.</string>
    <key>NSRemovableVolumesUsageDescription</key>
    <string>StreamDAB Analyser accesses removable volumes to analyze ETI stream files from external storage devices.</string>

    <!-- Application Category -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>

    <!-- Copyright -->
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 StreamDAB Analyser Team. All rights reserved.</string>

    <!-- Bundle URL Schemes for deep linking -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>StreamDAB Protocol</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>streamdab</string>
                <string>eti</string>
            </array>
        </dict>
    </array>

    <!-- App Transport Security (for network streaming) -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>localhost</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
                <key>NSExceptionMinimumTLSVersion</key>
                <string>TLSv1.0</string>
                <key>NSExceptionRequiresForwardSecrecy</key>
                <false/>
                <key>NSIncludesSubdomains</key>
                <true/>
            </dict>
        </dict>
    </dict>

    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>LSRequiresIPhoneOS</key>
    <false/>
    <key>CFBundleSupportedPlatforms</key>
    <array>
        <string>MacOSX</string>
    </array>
</dict>
</plist>