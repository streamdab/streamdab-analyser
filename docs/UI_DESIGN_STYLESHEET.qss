/* ============================================================================
   StreamDAB Analyzer - Professional Qt6 Stylesheet
   Based on DAB-XPlorer Light Theme
   Version: 1.0
   Last Updated: 2025-10-23
   ============================================================================ */

/* ===== COLOR DEFINITIONS (CSS Variables - Qt6 Compatible) ===== */

/* Primary Colors */
QMainWindow {
    --primary-bg: #f5f5f5;
    --secondary-bg: #ffffff;
    --border-color: #cccccc;
    --text-primary: #212121;
    --text-secondary: #757575;
}

/* Status Colors */
/* Active/Pass: #4CAF50 (Green) */
/* Warning: #FF9800 (Orange) */
/* Error/Critical: #F44336 (Red) */
/* Info: #2196F3 (Blue) */

/* ETSI Compliance Colors */
/* Critical: #d32f2f */
/* Warning: #f57c00 */
/* Info: #1976d2 */
/* Pass: #388e3c */

/* Hex Viewer Colors */
/* Sync: #d32f2f (Red) */
/* Header: #f57c00 (Orange) */
/* FIC: #388e3c (Green) */
/* MSC: #1976d2 (Blue) */
/* ASCII: #757575 (Grey) */

/* Selection & Hover */
/* Selection BG: #e3f2fd (Light blue) */
/* Hover BG: #f5f5f5 (Light grey) */

/* ===== MAIN WINDOW ===== */
QMainWindow {
    background-color: #f0f0f0;
    color: #212121;
}

/* ===== TAB WIDGET (Main Tabs) ===== */
QTabWidget::pane {
    border: 1px solid #cccccc;
    background-color: #ffffff;
    border-radius: 4px;
    padding: 2px;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar::tab {
    background-color: #e0e0e0;
    color: #212121;
    padding: 8px 20px;
    margin-right: 2px;
    border: 1px solid #cccccc;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 11px;
    font-weight: bold;
    min-width: 150px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #1976d2;
    border-bottom: 2px solid #1976d2;
}

QTabBar::tab:hover {
    background-color: #f5f5f5;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

/* ===== GROUP BOX ===== */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 10px;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 8px;
    background-color: #f5f5f5;
    border: 1px solid #cccccc;
    border-radius: 3px;
    color: #1976d2;
    font-weight: bold;
    font-size: 11px;
}

/* ===== TREE WIDGET ===== */
QTreeWidget {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 4px;
    alternate-background-color: #f9f9f9;
    selection-background-color: #e3f2fd;
    selection-color: #212121;
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 10px;
    show-decoration-selected: 1;
}

QTreeWidget::item {
    padding: 4px;
    border: none;
}

QTreeWidget::item:hover {
    background-color: #f5f5f5;
}

QTreeWidget::item:selected {
    background-color: #e3f2fd;
    color: #212121;
}

QTreeWidget::item:selected:active {
    background-color: #bbdefb;
}

QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    border-image: none;
    image: url(:/icons/branch-closed.png);
}

QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    border-image: none;
    image: url(:/icons/branch-open.png);
}

QHeaderView::section {
    background-color: #f5f5f5;
    color: #212121;
    padding: 4px;
    border: 1px solid #cccccc;
    border-right: none;
    border-bottom: 1px solid #aaaaaa;
    font-weight: bold;
    font-size: 10px;
}

QHeaderView::section:last {
    border-right: 1px solid #cccccc;
}

QHeaderView::section:hover {
    background-color: #e8e8e8;
}

/* ===== LIST WIDGET ===== */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 4px;
    alternate-background-color: #f9f9f9;
    selection-background-color: #e3f2fd;
    selection-color: #212121;
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 10px;
}

QListWidget::item {
    padding: 4px;
    border: none;
}

QListWidget::item:hover {
    background-color: #f5f5f5;
}

QListWidget::item:selected {
    background-color: #e3f2fd;
    color: #212121;
}

QListWidget::item:selected:active {
    background-color: #bbdefb;
}

/* ===== TABLE WIDGET ===== */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 4px;
    gridline-color: #e0e0e0;
    selection-background-color: #e3f2fd;
    selection-color: #212121;
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 10px;
}

QTableWidget::item {
    padding: 4px;
}

QTableWidget::item:alternate {
    background-color: #f9f9f9;
}

QTableWidget::item:hover {
    background-color: #f5f5f5;
}

QTableWidget::item:selected {
    background-color: #e3f2fd;
    color: #212121;
}

QTableWidget QTableCornerButton::section {
    background-color: #f5f5f5;
    border: 1px solid #cccccc;
}

/* ===== TEXT EDIT / PLAIN TEXT EDIT ===== */
QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 4px;
    color: #212121;
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 10px;
    selection-background-color: #e3f2fd;
    selection-color: #212121;
    padding: 4px;
}

/* ===== LABEL ===== */
QLabel {
    color: #212121;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 10px;
    background-color: transparent;
}

/* ===== PROGRESS BAR ===== */
QProgressBar {
    border: 1px solid #cccccc;
    border-radius: 4px;
    background-color: #f5f5f5;
    text-align: center;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 10px;
    font-weight: bold;
    color: #212121;
    height: 20px;
}

QProgressBar::chunk {
    background-color: #4CAF50;
    border-radius: 3px;
}

/* Quality-based progress bar colors (set via property) */
QProgressBar[quality="high"]::chunk {
    background-color: #4CAF50; /* Green: 75-100% */
}

QProgressBar[quality="medium"]::chunk {
    background-color: #FF9800; /* Orange: 50-75% */
}

QProgressBar[quality="low"]::chunk {
    background-color: #F44336; /* Red: 0-50% */
}

/* ETSI Compliance progress bar */
QProgressBar[compliance="true"]::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                     stop:0 #4CAF50,
                                     stop:0.8 #4CAF50,
                                     stop:0.9 #FF9800,
                                     stop:1 #F44336);
}

/* ===== PUSH BUTTON ===== */
QPushButton {
    background-color: #e0e0e0;
    color: #212121;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 6px 12px;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 10px;
    font-weight: bold;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #d0d0d0;
    border: 1px solid #1976d2;
}

QPushButton:pressed {
    background-color: #c0c0c0;
    border: 1px solid #0d47a1;
}

QPushButton:disabled {
    background-color: #f5f5f5;
    color: #bdbdbd;
    border: 1px solid #e0e0e0;
}

/* Primary action button */
QPushButton[primary="true"] {
    background-color: #1976d2;
    color: #ffffff;
    border: 1px solid #0d47a1;
}

QPushButton[primary="true"]:hover {
    background-color: #1565c0;
}

QPushButton[primary="true"]:pressed {
    background-color: #0d47a1;
}

/* Danger button */
QPushButton[danger="true"] {
    background-color: #F44336;
    color: #ffffff;
    border: 1px solid #d32f2f;
}

QPushButton[danger="true"]:hover {
    background-color: #e53935;
}

/* ===== COMBO BOX ===== */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 4px 8px;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 10px;
    min-width: 120px;
}

QComboBox:hover {
    border: 1px solid #1976d2;
}

QComboBox:focus {
    border: 1px solid #1976d2;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #cccccc;
}

QComboBox::down-arrow {
    image: url(:/icons/down-arrow.png);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    selection-background-color: #e3f2fd;
    selection-color: #212121;
    padding: 2px;
}

/* ===== SPIN BOX ===== */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 4px 8px;
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 10px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border: 1px solid #1976d2;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    border-left: 1px solid #cccccc;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    border-left: 1px solid #cccccc;
}

/* ===== SPLITTER ===== */
QSplitter::handle {
    background-color: #cccccc;
}

QSplitter::handle:horizontal {
    width: 4px;
    margin: 0px 2px;
}

QSplitter::handle:vertical {
    height: 4px;
    margin: 2px 0px;
}

QSplitter::handle:hover {
    background-color: #1976d2;
}

QSplitter::handle:pressed {
    background-color: #0d47a1;
}

/* ===== SCROLL BAR ===== */
/* Vertical Scrollbar */
QScrollBar:vertical {
    background-color: #f5f5f5;
    width: 12px;
    border: none;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #cccccc;
    min-height: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #bdbdbd;
}

QScrollBar::handle:vertical:pressed {
    background-color: #9e9e9e;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* Horizontal Scrollbar */
QScrollBar:horizontal {
    background-color: #f5f5f5;
    height: 12px;
    border: none;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #cccccc;
    min-width: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #bdbdbd;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #9e9e9e;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ===== STATUS BAR ===== */
QStatusBar {
    background-color: #f5f5f5;
    border-top: 1px solid #cccccc;
    color: #212121;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 10px;
    padding: 2px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    padding: 2px 4px;
}

/* ===== MENU BAR ===== */
QMenuBar {
    background-color: #f5f5f5;
    border-bottom: 1px solid #cccccc;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 10px;
    padding: 2px;
}

QMenuBar::item {
    padding: 4px 12px;
    background-color: transparent;
}

QMenuBar::item:selected {
    background-color: #e3f2fd;
    color: #1976d2;
}

QMenuBar::item:pressed {
    background-color: #bbdefb;
}

/* ===== MENU ===== */
QMenu {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 10px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 2px;
}

QMenu::item:selected {
    background-color: #e3f2fd;
    color: #1976d2;
}

QMenu::separator {
    height: 1px;
    background-color: #e0e0e0;
    margin: 4px 8px;
}

QMenu::icon {
    padding-left: 8px;
}

/* ===== TOOL BAR ===== */
QToolBar {
    background-color: #f5f5f5;
    border: 1px solid #cccccc;
    spacing: 3px;
    padding: 4px;
}

QToolBar::separator {
    background-color: #cccccc;
    width: 1px;
    margin: 4px 2px;
}

QToolBar::handle {
    background-color: #cccccc;
    width: 8px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px;
    margin: 2px;
}

QToolButton:hover {
    background-color: #e3f2fd;
    border: 1px solid #1976d2;
}

QToolButton:pressed {
    background-color: #bbdefb;
    border: 1px solid #0d47a1;
}

QToolButton:checked {
    background-color: #bbdefb;
    border: 1px solid #1976d2;
}

/* ===== CHECK BOX ===== */
QCheckBox {
    spacing: 5px;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 10px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #cccccc;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border: 1px solid #1976d2;
}

QCheckBox::indicator:checked {
    background-color: #1976d2;
    border: 1px solid #1976d2;
    image: url(:/icons/check-white.png);
}

QCheckBox::indicator:checked:hover {
    background-color: #1565c0;
}

QCheckBox::indicator:disabled {
    background-color: #f5f5f5;
    border: 1px solid #e0e0e0;
}

/* ===== RADIO BUTTON ===== */
QRadioButton {
    spacing: 5px;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 10px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #cccccc;
    border-radius: 8px;
    background-color: #ffffff;
}

QRadioButton::indicator:hover {
    border: 1px solid #1976d2;
}

QRadioButton::indicator:checked {
    background-color: #1976d2;
    border: 1px solid #1976d2;
}

QRadioButton::indicator:checked:hover {
    background-color: #1565c0;
}

/* ===== LINE EDIT ===== */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 4px 8px;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 10px;
    selection-background-color: #e3f2fd;
    selection-color: #212121;
}

QLineEdit:hover {
    border: 1px solid #1976d2;
}

QLineEdit:focus {
    border: 1px solid #1976d2;
}

QLineEdit:disabled {
    background-color: #f5f5f5;
    color: #bdbdbd;
    border: 1px solid #e0e0e0;
}

/* ===== TEXT BROWSER ===== */
QTextBrowser {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 4px;
    color: #212121;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 10px;
    selection-background-color: #e3f2fd;
    selection-color: #212121;
    padding: 4px;
}

/* ===== SPECIAL STYLING FOR STATUS LABELS ===== */
QLabel[status="active"] {
    color: #4CAF50;
    font-weight: bold;
}

QLabel[status="warning"] {
    color: #FF9800;
    font-weight: bold;
}

QLabel[status="error"] {
    color: #F44336;
    font-weight: bold;
}

QLabel[status="info"] {
    color: #2196F3;
    font-weight: bold;
}

QLabel[status="critical"] {
    color: #d32f2f;
    font-weight: bold;
}

/* ===== DOCK WIDGET (For future use) ===== */
QDockWidget {
    titlebar-close-icon: url(:/icons/close.png);
    titlebar-normal-icon: url(:/icons/undock.png);
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 10px;
}

QDockWidget::title {
    background-color: #f5f5f5;
    padding: 4px;
    border: 1px solid #cccccc;
    text-align: left;
}

QDockWidget::close-button, QDockWidget::float-button {
    border: none;
    background: transparent;
    padding: 2px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: #e3f2fd;
}

/* ===== TOOLTIP ===== */
QToolTip {
    background-color: #ffffcc;
    border: 1px solid #cccccc;
    color: #212121;
    padding: 4px;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 10px;
    border-radius: 2px;
}

/* ===== SPECIAL WIDGETS ===== */

/* Hex Viewer specific (to be applied via code) */
QTextEdit[widget-type="hex-viewer"] {
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 10px;
    line-height: 1.4;
}

/* System Messages specific */
QTextEdit[widget-type="system-messages"] {
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 10px;
}

/* Performance Metrics Labels */
QLabel[metric-type="performance"] {
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 11px;
    font-weight: bold;
}

/* Now Playing Labels */
QLabel[widget-type="now-playing-title"] {
    font-weight: bold;
    color: #1976d2;
}

QLabel[widget-type="now-playing-value"] {
    font-size: 11px;
}

/* ===== END OF STYLESHEET ===== */
